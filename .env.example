# Copy this file to .env and fill in your own values. Never commit .env.

# The API base URL of your Dify, ending in /v1.
# - A lab on the internet: the "Service API address" on the "API address for programs" card of your lab.
# - A Dify on your own machine: http://127.0.0.1:8080/v1
# This address is not a secret.
DIFY_BASE_URL=https://<your-lab-address>/v1

# Only for a lab on the internet: the "Lab capability" from the same card. It IS a secret, like the keys
# below: whoever has it can call your lab's API until the lab closes. If it gets out, close the lab.
# Leave it empty for a Dify on your own machine.
DIFY_LAB_CAPABILITY=

# App API key: Dify → your Exercise 3 app → API Access → API Key (starts with app-)
DIFY_APP_KEY=app-xxxxxxxxxxxxxxxx

# Knowledge API key: Dify → Knowledge → API → API Key (starts with dataset-)
DIFY_DATASET_KEY=dataset-xxxxxxxxxxxxxxxx

# Knowledge base ID: open your Jira_API_* knowledge base, copy the id from the URL
# https://.../datasets/<THIS-ID>/documents
DIFY_DATASET_ID=00000000-0000-0000-0000-000000000000

# Level 3 (LLM-as-a-judge): import the "Exercise 5: RAG Judge" DSL into Dify, publish it,
# then API Access → API Key (starts with app-)
DIFY_JUDGE_KEY=app-xxxxxxxxxxxxxxxx
